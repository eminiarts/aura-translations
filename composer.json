{
    "name": "eminiarts/aura-translations",
    "type": "aura-plugin",
    "description": "Multilingual resource translations for Aura CMS.",
    "keywords": [
        "aura",
        "aura-cms",
        "translations",
        "multilingual",
        "livewire"
    ],
    "homepage": "https://github.com/eminiarts/aura-translations",
    "license": "MIT",
    "authors": [
        {
            "name": "Bajram Emini",
            "email": "bajram@eminiarts.ch",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "eminiarts/aura-cms": "^0.2.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "spatie/laravel-package-tools": "^1.14"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^7.9|^8.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Aura\\Translations\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aura\\Translations\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aura\\Translations\\TranslationsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
